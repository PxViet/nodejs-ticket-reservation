# The host only — api/v1 is appended by src/services/api/config.ts.
# iOS simulator: http://localhost:3000 · Android emulator: http://10.0.2.2:3000
# (localhost inside an Android emulator is the emulator itself, not your machine).
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_PREFIX=
EXPO_PUBLIC_API_VERSION=
GOOGLE_SERVICES_JSON=
# Stripe publishable key (pk_test_… / pk_live_…) — public by design, and the
# same value as STRIPE_PUBLISHABLE_KEY in apps/api/.env (ADR-018).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
