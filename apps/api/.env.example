# Copy to .env and fill in. Every key here is validated at boot by
# src/config/env.validation.ts — a missing or malformed value fails startup.

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=*
SWAGGER_ENABLED=true
LOG_LEVEL=info

# --- Rate limiting (in-memory, per instance) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Database (matches docker-compose.yml) ---
# localhost when the API runs on the host against the compose-published port
# (`pnpm run db:up`); `postgres` (the compose service name) when the API
# itself runs in `docker compose up`'s `app` container.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ticket_reservation
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# --- Auth (generated key pair, base64-encoded PEM) ---
# Generate a local pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   openssl base64 -A -in private.pem   (paste as JWT_PRIVATE_KEY_BASE64)
#   openssl base64 -A -in public.pem    (paste as JWT_PUBLIC_KEY_BASE64)
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Seed (DDR-009): the only way an admin account is ever created ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# --- Payments (ADR-017): Stripe test-mode keys from dashboard.stripe.com ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
