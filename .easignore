# EAS uploads the whole workspace root. Nothing outside the mobile app and the
# packages it depends on needs to travel to the build server.
apps/api/
docs/
.github/
.gitlab/
.husky/
.claude/
docker-compose*.yml
cspell.json

# large local artefacts
**/node_modules/
**/dist/
**/coverage/
**/.turbo/

# .easignore replaces .gitignore for the upload, so everything below mirrors it.
# Native folders are generated by prebuild on the build server; a local copy
# carries a machine-specific autolinking cache and makes EAS skip prebuild.
apps/mobile/android/
apps/mobile/ios/
.expo/

# env files and signing material
.env
.env.local
.env.*.local
.env.staging
.env.production
google-services.json
movies-ticket-booking.json
